# Provider mode
# litellm: organization policy mode
LLM_PROVIDER=litellm

# Model name routed through LiteLLM gateway
MODEL_NAME=gpt-5.2

# Agent safety guard
MAX_AGENT_TURNS=6

# Provider request timeout (seconds)
LITELLM_TIMEOUT=60

# Optional LiteLLM proxy mode
# If using a self-hosted LiteLLM gateway, set both values below.
LITELLM_BASE_URL=https://your-litellm-gateway/v1
LITELLM_API_KEY=your_litellm_gateway_key

